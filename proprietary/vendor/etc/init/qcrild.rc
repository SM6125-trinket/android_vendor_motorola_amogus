service vendor.qcrild /vendor/bin/hw/qcrild
    class main
    user radio
    socket cutback stream 660 audioserver radio
    socket ril_ipc seqpacket 660 radio radio /dev/socket/qmux_radio
    group radio cache inet misc audio log readproc wakelock oem_2901 net_raw wifi diag input
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    interface android.hardware.radio@1.0::IRadio slot1
    interface android.hardware.radio@1.1::IRadio slot1
    interface android.hardware.radio@1.2::IRadio slot1
    interface android.hardware.radio@1.3::IRadio slot1
    interface android.hardware.radio@1.4::IRadio slot1
    interface android.hardware.radio@1.5::IRadio slot1
    interface android.hardware.radio.config@1.0::IRadioConfig default
    interface android.hardware.radio.config@1.1::IRadioConfig default
    interface android.hardware.radio@1.0::ISap slot1
    interface android.hardware.radio@1.1::ISap slot1
    interface android.hardware.radio@1.2::ISap slot1
    interface vendor.qti.hardware.radio.am@1.0::IQcRilAudio slot1
    interface vendor.qti.hardware.radio.ims@1.0::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.1::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.2::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.3::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.4::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.5::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.6::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.ims@1.7::IImsRadio imsradio0
    interface vendor.qti.hardware.radio.qtiradio@1.0::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.0::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.1::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.2::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.3::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.4::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.5::IQtiRadio slot1
    interface vendor.qti.hardware.radio.qtiradio@2.6::IQtiRadio slot1
    interface vendor.qti.hardware.radio.uim@1.0::IUim Uim0
    interface vendor.qti.hardware.radio.uim@1.1::IUim Uim0
    interface vendor.qti.hardware.radio.uim@1.2::IUim Uim0
    interface vendor.qti.hardware.radio.uim_remote_client@1.0::IUimRemoteServiceClient uimRemoteClient0
    interface vendor.qti.hardware.radio.uim_remote_server@1.0::IUimRemoteServiceServer uimRemoteServer0
    interface vendor.qti.hardware.radio.lpa@1.0::IUimLpa UimLpa0
    interface vendor.qti.hardware.radio.lpa@1.1::IUimLpa UimLpa0
    interface vendor.qti.hardware.radio.qcrilhook@1.0::IQtiOemHook oemhook0

